# Copy to .env and fill in. NEVER commit real secrets.
# The values below are non-functional placeholders.

# PostgreSQL with PostGIS
DATABASE_URL=postgresql://opencaribe:opencaribe@localhost:5432/opencaribe

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:3000

# Social SSO (optional — providers appear only when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Authorized redirect URIs must end with:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/twitter

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_COUNTRY=TT

# Object storage (S3-compatible) - phase 2
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email delivery - phase 2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.invalid

# Observability - phase 3
OTEL_EXPORTER_OTLP_ENDPOINT=

# Gno.land payments (Phase 1: read-only wallet connect on testnet)
GNO_CHAIN_ID=onyx-1
GNO_RPC_URL=https://rpc.onyx.testnets.gno.land:443
GNO_FAUCET_URL=https://faucet.gno.land
